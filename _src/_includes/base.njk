<!doctype html>
<html lang="en">
    
<head>
     <meta charset="UTF-8">
     <meta name="viewport" 
           content="width=device-width, 
           user-scalable=no, 
           initial-scale=1.0, 
           maximum-scale=1.0, 
           minimum-scale=1.0">
     <meta http-equiv="X-UA-Compatible" 
           content="ie=edge">
         <link rel="stylesheet" href="css/css.css">
             <script type="module" src="js/is-land.js"></script>
             
             
     <title>Tech Issue</title>
             <nav aria-label="Guide sections">
                 <ul>
                     <li><a href="index.html">Home</a></li>
                     <li><a href="guide.html">AI Copyright Tech Issue Guide</a></li>
                 
                     {% for section in sections %}
                     <li>
                         <a href="#{{ section.data.title | slugify }}">
                             {{ section.data.title }}
                         </a>
                     </li>
                     {% endfor %}
                 </ul>
             </nav>
</head>
<body>
<h1>Welcome to 11ty!!!</h1>
    {{ content | safe }}
    
    <footer>
        <p>
            <a href="https://www.zotero.org/groups/6655821/copyright_and_ai-generated_media" target="blank">
                Link to Zotero Library
            </a>
        </p>
        <strong>Page last updated:</strong>
        
        {% if gitLastCommit %}
        <time class="fmt-date" datetime="{{ gitLastCommit }}">{{ gitLastCommit }}</time>
        {% else %}
        <em>not yet committed</em>
        {% endif %}
        
        &middot;
        
        <strong>Site last built:</strong>
        <time class="fmt-date" datetime="{{ build.timestamp }}">{{ build.timestamp }}</time>
        
        <is-land on:visible>
            <template data-island>
                <script type="module">
                    const fmt = new Intl.DateTimeFormat(undefined, {
                        dateStyle: "medium",
                        timeStyle: "short"
                    });

                    document.querySelectorAll("time.fmt-date").forEach((el) => {
                        el.textContent = fmt.format(
                            new Date(el.getAttribute("datetime"))
                        );
                    });
                </script>
            </template>
        </is-land>
    </footer>
</body>
</html>