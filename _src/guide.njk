---
title: My Tech Issue Guide
layout: base.njk
permalink: guide.html
---

{% set sections = collections.section | sort(false, false, "data.order") %}

<main>
    <h1>{{ title }}</h1>
    
    <is-land on:visible>
        <div id="counters">
            <div v-scope="Counter({ initialCount: 5 })">
                <p>Count: <span v-text="count"></span></p>
                <button @click="increment">+</button>
            </div>
            <div v-scope="Counter({ initialCount: 20 })">
                <p>Count: <span v-text="count"></span></p>
                <button @click="increment">+</button>
            </div>
        </div>
        
        <template data-island>
            <script type="module">
                import { createApp } from './js/petite-vue.js'
                
                function Counter(props) {
                return {
                count: props.initialCount,
                increment() { this.count++ }
                }
                }
                
                createApp({ Counter }).mount('#counters')
            </script>
        </template>
    </is-land>
    
    <nav aria-label="Guide sections">
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/guide.html">AI Copyright Tech Issue Guide</a></li>
            {% for section in sections %}
            <li>
                <a href="#{{ section.data.title | slugify }}">
                    {{ section.data.title }}
                </a>
            </li>
            {% endfor %}
        </ul>
    </nav>
    
    {% for section in sections %}
    <section id="{{ section.data.title | slugify }}">
        <h2>{{ section.data.title }}</h2>
        
        {% if section.data.image %}
        <figure>
            <img src="{{ section.data.image }}" alt="{{ section.data.image_alt }}">
                {% if section.data.image_credit %}
                <figcaption>{{ section.data.image_credit | safe }}</figcaption>
                {% endif %}
        </figure>
        {% endif %}
        
        {{ section.templateContent | safe }}
    </section>
    {% endfor %}
</main>
